(M29 CLOSE Chuck)

o<m29> sub
(debug,executing m28.ngc file)
(expose the remap level)
(debug, M31; call_level= #<_call_level> remap_level=#<_remap_level>)
(debug, Opening Chuck)

    o100 if [#<_spindle_on> EQ 0]
        M65 P#<_ini[MOTION_OUT]CHUCK_OPEN>
        G04 P#<_ini[DWELL]CHUCK_DWELL>
    o100 endif

o<m29> endsub
M2