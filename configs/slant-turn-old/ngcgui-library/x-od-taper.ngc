; Author: D.Dempsey
(info: Turn OD taper or straight turn to a square shoulder)

o<x-od-taper> sub

(Parameters)
#<StartDia> = #1 (=2.0000 Material Dia)
#<X0> = #2 (= 3.0000 X Retract)
#<Z0> = #3 (= 0.2500 Z Retract) 
#<X1> = #4 (=1.0000 X1 Start of Taper)
#<Z1> = #5 (=0.0000 Z1 Start of Taper)
#<Z2> = #6 (=-1.5000 Z2 End of Taper)
#<Angle> = #7 (=10 Angle in Degrees)
#<I> = #8 (=0.020 X Fin. Allowance)
#<K> = #9 (=0.010 Z Fin. Allowance)
#<NumPasses> = #10 (=7)
#<ToolNumber> = #11 (=01)
#<ToolOffset> = #12 (=01)
#<CSS> = #13 (=200 Rough CSS Units/Min)
#<FeedRate> = #14 (=0.020 Rough Feed Units/Min)
#<FinishCSS> = #15 (=400 Finish CSS Units/Min) 
#<FinishFeedRate> = #16 (=0.010 Finish Feed Units/Min)
#<Gear> = #17 (=39 Gear Low=37 High=39)
#<GearMaxRPM> = #18 (=3500) 
#<SpindleDir> = #19 (=04)
#<Coolant> = #20 (=8 Coolant On=8, Off=9)
#<UTC> = #21 (=1 UTC Active  No=0 Yes=1)



(Calculations)
;Calculate the diameter at the end of the Taper
#<X2> = [#<X1> + [#<Z1> - #<Z2>] * TAN[#<Angle>]]
;(debug, X2 = #<X2>)

;Calculate the projected diameter directly below the retract point
#<X3> = [#<X1> - [#<Z1> + #<Z0>] * TAN[#<Angle>]]
#<Z3> = #<Z0>
;(debug, X3 = #<X3>)
;(debug, Z3 = #<Z3>)

;Calculate the projected diameter + finishing allowance
#<X4> = [#<X3> + #<I>]
#<Z4> = #<Z0>
;(debug, X4 = #<X4>)
;(debug, Z4 = #<Z4>)

;Calculate the distance to the end of the taper + finishing allowance
#<Z5> = [#<Z2> + #<K>]
;(debug, Z5 = #<Z5>)

;Calculate the X step based on the number of passes.
#<Xstep> = [[#<StartDia> - #<X4>] / [#<NumPasses>]] 
;(debug, Xstep = #<Xstep>)

#<DOC> = [#<Xstep> / 2] 
;(debug, DOC = #<DOC>)

;Calculate the fanuc style tool number 
#<fanuc_tool_number>= [[#<ToolNumber> * 100] + #<ToolOffset>]
;(debug, fanuc tool number = #<fanuc_tool_number>)


;Calculate the starting rpm based on the staring diameter to avoid 
;wild rpm swings when G96 is called
#<StartRPM> = [3.82 * [#<CSS> / #<StartDia>]]
;(debug, Start Spindle at #<StartRPM> RPM)

;Make sure we know the universal tool change position G53 G00 Xxxxx Zxxxx  
;(debug, G53 X#<_XG53> Z#<_ZG53>)

(Sanity Checks)
o910 if [[#<Gear> NE 37] AND [#<Gear> NE 39]]
        (ABORT, EXITING -- No Gear Selected)
o910 endif

o920 if [[#<Gear> EQ 37] AND [#<GearMaxRPM> GT 1500]]
        (debug, Max RPM is too high for selected gear -- EXITING)
        (ABORT, EXITING -- Max RPM is too high for selected gear)
o920 endif

o930 if [[#<Gear> EQ 39] AND [#<GearMaxRPM> GT 3500]]
        (ABORT, EXITING -- Max Rpm is too high for selected gear)
o930 endif

o940 if [#<ToolNumber> NE #<ToolOffset>]
        (ABORT, EXITING -- Offset Number does not match tool number)
o940 endif

o950 if [[#<UTC> NE 0] AND [#<UTC> NE 1]]
        (ABORT, EXITING -- UniversalTool Change Not Specified)
o950 endif

o960 if [#<Angle> LT 0]
        (ABORT, EXITING -- Angle must be greater than 0)
o960 endif 

(If we've got here, its time to get down to business)
(Setup Commands)
G18                         ;XZ Plane
G7                          ;Dia. Mode
G40                         ;Cancel Cutter Comp
G49                         ;Cancel Tool Length Comp

(Tool Change)
o100 if [#<UTC> EQ 1]
        G53 G00 X#<_XG53> Z#<_ZG53> ;Tool Change Position         
o100 endif

M6 T#<fanuc_tool_number>    ;Tool Change 
#<D> = #5410
#<L> = #5413

(Gear Change)
M#<Gear>                   ;Shift Gears
G04 P2                     ;Wait for gear shift to complete

(Spindle)
G97 S#<StartRPM>            ;RPM mode
M#<SpindleDir> M#<Coolant>  ;Spindle On, Coolant On
G04 P1                      ;Wait 

(Start Position)
G41.1 D#<D> L#<L>           ;Dynamic Cutter Comp On  
G00 X#<X0> Z#<Z0>           ;Rapid to Starting Position
G96 D#<GearMaxRPM> S#<CSS>  ;CSS On
G95 F#<FeedRate>            ;Units/Rev
G04 P1                      ;Wait
#<Pass> = 1                 ;Start Counting

(Roughing Pass)
o200 repeat[#<NumPasses>]
        
        ;(debug, pass = #<Pass>)
        ;Calculate the Cutting Dia
        #<CutDia> = [#<StartDia> - [#<Xstep> * #<Pass>]]
        

        ;Calculate the projected point 
        #<Xtemp> = [#<CutDia> + [#<Z4> - #<Z5>] * TAN[#<Angle>]] 
        

    o210 if [#<Xtemp> GE #<X0>]
            (debug, Projected point above Retract Pt, Recalculating ...)
            #<X5> = #<X0>
            #<Ztemp> =[#<Z0> - [[ 1 / TAN[#<Angle>]] * [#<X0> - #<CutDia>]]] 
            (debug, Ztemp = #<Ztemp>)
            G00 X#<CutDia> 
            G01 X#<X5> Z#<Ztemp> 
            G01 X#<X0>> 
            G00 Z#<Z0>
            
    o210 else
            #<X5> = #<Xtemp>
            #<Z5> = [#<Z2> + #<K>]
            G00 X#<CutDia> 
            G01 X#<X5> Z#<Z5> 
            G01 X#<X0>  
            G00 Z#<Z0>            

    o210 endif

    #<Pass> = [#<Pass> + 1]    
    
o200 endrepeat

(Finishing Pass)
F#<FinishFeedRate>          
S#<FinishCSS>
G04 P1      
G00 X#<X3> 
G01 X#<X2> Z#<Z2> F#<FinishFeedRate>
G01 X#<X0>  
G00 Z#<Z0>

(Cleanup)
G40                             ;Cancel cutter compensation
o110 if [#<UTC> EQ 1]
        G53 G00 X#<_XG53> Z#<_ZG53> ;Rapid to Tool Change Position         
o110 endif
G49                             ;Cancel Tool Offset
G97 S#<StartRPM>                ;Rpm Mode
G95 F#<FeedRate>                ;Unit/Rev
M5 M9                           ;Spindle OFF, All Coolant OFF
M36                             ;Shift to NEUTRAL

o<x-od-taper> endsub
