########################################################################
# Delta ASDA-A2E AC Servo HAL File
#
#
#
#
#
######################################################################## 

########################################################################
# X-Axis (Joint 0)
########################################################################

# Connect the amplifiers mode pins to the correspoding motion.digital-out-xx
# pins as listed in the .ini file
net xmp-0 motion.digital-out-00 lcec.0.A1.op-mode-0
net xmp-1 motion.digital-out-01 lcec.0.A1.op-mode-1
net xmp-2 motion.digital-out-02 lcec.0.A1.op-mode-2
net xmp-3 motion.digital-out-03 lcec.0.A1.op-mode-3
net xmp-4 motion.digital-out-04 lcec.0.A1.op-mode-4
net xmp-5 motion.digital-out-05 lcec.0.A1.op-mode-5
net xmp-6 motion.digital-out-06 lcec.0.A1.op-mode-6
net xmp-7 motion.digital-out-07 lcec.0.A1.op-mode-7

# Statically enable 0x6040 = 0x06
setp lcec.0.A1.enable-voltage 1
setp lcec.0.A1.quick-stop 1

# connect the target position command to the servo,
# Note: the gear ratio/scaling is taken care of in the xml file
net x-pos-cmd   lcec.0.A1.srv-pos-cmd <= joint.0.motor-pos-cmd
net x-pos-fb    lcec.0.A1.srv-pos-fb  => joint.0.motor-pos-fb

# Connect the x-axis limit switches
net x-neg-lsw  lcec.0.A1.neg-lsw => joint.0.neg-lim-sw-in
net x-pos-lsw  lcec.0.A1.pos-lsw => joint.0.pos-lim-sw-in

net x-amps-in    lcec.0.A1.amps => conv-amps.0.amps-in
net z-amps-in    lcec.0.A2.amps => conv-amps.1.amps-in

#net x-home-auto-sync joint.0.home_auto_sync <= classicladder.0.out-96
#net x-home-lsw-sync  classicladder.0.in-64 <= lcec.0.A1.home-lsw

########################################################################
# Z axis (Joint 1)
########################################################################

net zmp-0 motion.digital-out-08 lcec.0.A2.op-mode-0
net zmp-1 motion.digital-out-09 lcec.0.A2.op-mode-1
net zmp-2 motion.digital-out-10 lcec.0.A2.op-mode-2
net zmp-3 motion.digital-out-11 lcec.0.A2.op-mode-3
net zmp-4 motion.digital-out-12 lcec.0.A2.op-mode-4
net zmp-5 motion.digital-out-13 lcec.0.A2.op-mode-5
net zmp-6 motion.digital-out-14 lcec.0.A2.op-mode-6
net zmp-7 motion.digital-out-15 lcec.0.A2.op-mode-7

# Statically enable 0x6040 = 0x06 
setp lcec.0.A2.enable-voltage 1
setp lcec.0.A2.quick-stop 1

net z-pos-cmd lcec.0.A2.srv-pos-cmd => joint.1.motor-pos-cmd
net z-pos-fb  lcec.0.A2.srv-pos-fb  => joint.1.motor-pos-fb

# Connect the z-axis limit switches 
net z-neg-lsw  lcec.0.A2.neg-lsw => joint.1.neg-lim-sw-in
net z-pos-lsw  lcec.0.A2.pos-lsw => joint.1.pos-lim-sw-in

########################################################################
# MPG
########################################################################

# set the encoder and ilowpass parameters
setp mpg.counter-mode 0
setp mpg.x4-mode 0
setp mpg.position-scale 400
# jog scale and enable are looked after by the gui, so all we need to do 
# is set the scale = 1
setp ilowpass.0.scale 1.0
setp ilowpass.0.gain  0.5

# connect A/B phases of the encoder
net mpg-phase-A lcec.0.D6.din-0 => mpg.phase-A
net mpg-phase-B lcec.0.D6.din-1 => mpg.phase-B
net mpg-counts  mpg.counts => ilowpass.0.in
net mpg-cmd     ilowpass.0.out => joint.0.jog-counts => joint.1.jog-counts













