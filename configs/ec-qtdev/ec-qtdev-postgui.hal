# Postgui.hal file for ec-qtdev lathe simulation

# Simulation Panel for E-Stop, MPG jogging 
loadusr -Wn lathe_panel qtvcp /home/daniel/dev/linuxcnc-dev/configs/ec-qtdev/lathezy_qt/panels/lathe_panel.ui

###############################################################################
# E-Stop Connections
###############################################################################

# Use the panel to simulate the external estop 
net ext-estop   classicladder.0.in-07 lathe_panel.estop

#input from linuxcnc estop button    
net linux-estop     classicladder.0.in-08       iocontrol.0.user-enable-out

# connect linuxcnc internal reset        
net linux-reset     classicladder.0.in-09       iocontrol.0.user-request-enable

# request e-stop enable from linuxcnc
net estop-ok        classicladder.0.out-12      iocontrol.0.emc-enable-in

