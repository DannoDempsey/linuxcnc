    padding: 10px;
}
*/

/* Style the push buttons */
QPushButton {
    border: 1px solid #000000;
    border-radius: 6px;
    background-color: #EBEBEB; 
}

QPushButton:pressed {
    background-color: #C0C0C0; 
}

QPushButton:checked {
    background-color: #C0C0C0;
}

QPushButton:disabled {
    color: white;
}

/* Style the ScrollBars*/
QScrollBar:horizontal {
    height: 30px;
    background-color: #EBEBEB;
}

QScrollBar::handle:horizontal {
    background-color: #2196F3;
    border-radius: 4px;
    margin: 0px 30px 0px 30px;
}

QScrollBar:vertical {
    width: 30px;
    background-color: #EBEBEB;
}

QScrollBar::handle:vertical {
    background-color: #2196F3;
    border-radius: 4px;
    margin: 30px 0px 30px 0px;
    min-height: 15px;
}

/* Style the adjustment sliders */
QProgressBar{
    background: white;
    border: 1px #000000;
    border-radius: 4px;
}

QProgressBar::chunk:horizontal {
    background-color: #2196F3;
}

